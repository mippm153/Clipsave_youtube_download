{
  "name": "clipsave",
  "version": "1.4.0",
  "description": "A local desktop app for downloading YouTube videos and playlists with yt-dlp.",
  "main": "src/main.js",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Local",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js",
    "dist": "npm run dist:mac && npm run dist:win",
    "dist:mac": "electron-builder --mac dir zip --arm64 --publish never",
    "dist:win": "electron-builder --win zip --x64 --publish never",
    "site:check": "node scripts/check-site-links.js",
    "configure:repo": "node scripts/configure-repo-owner.js"
  },
  "build": {
    "appId": "app.clipsave.desktop",
    "productName": "ClipSave",
    "artifactName": "ClipSave-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dir",
        "zip"
      ],
      "identity": null,
      "extraResources": [
        {
          "from": "resources/bin/darwin-arm64",
          "to": "bin/darwin-arm64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "zip"
      ],
      "extraResources": [
        {
          "from": "resources/bin/win32-x64",
          "to": "bin/win32-x64",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
